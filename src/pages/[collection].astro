---
import Layout from "../layouts/Layout.astro";
import CollectionGallery from "../components/CollectionGallery.astro";
import { getCollection } from "astro:content";
import { COLLECTIONS } from "../lib/collections";
import { matchPhotosToSlots } from "../lib/gallery";

export function getStaticPaths() {
  return Object.keys(COLLECTIONS).map((collection) => ({
    params: { collection },
  }));
}

const { collection } = Astro.params;

if (!collection || !(collection in COLLECTIONS)) {
  return Astro.redirect("/");
}

const { title, slots } = COLLECTIONS[collection];
const allGallery = await getCollection("gallery");
const galleryEntries = allGallery.filter(
  (photo) => photo.data.collection?.toLowerCase() === collection,
);
const slotted = matchPhotosToSlots(galleryEntries, slots);
---

<Layout title={`${title} | Alex Broley`}>
  <CollectionGallery title={title} slots={slots} slotted={slotted} />
</Layout>
