---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <div class="flex flex-col gap-0 pt-10 px-4 md:px-0">
    <section class="max-w-xl">
      <h1 class="text-4xl font-baskerville mb-12">Get in Touch</h1>
      <p class="text-neutral-600 font-sans mb-6">
        Reach me by email or on Instagram.
      </p>
      <ul class="flex flex-col gap-4 font-sans">
        <li>
          <a
            href="mailto:alex.broley@gmail.com"
            class="text-neutral-900 border-b border-black pb-0.5 hover:text-neutral-500 hover:border-neutral-500 transition-colors duration-300"
          >
            alex.broley@gmail.com
          </a>
        </li>
        <li>
          <a
            href="https://instagram.com/alex.broley"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-900 border-b border-black pb-0.5 hover:text-neutral-500 hover:border-neutral-500 transition-colors duration-300"
          >
            @alex.broley
          </a>
        </li>
      </ul>
    </section>
  </div>
</Layout>
